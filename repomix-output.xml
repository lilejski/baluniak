        aria-pressed={lang === "PL"}
      >
        <FlagPL className={cn("rounded-sm", flagSize)} />
      </button>
      <button
        type="button"
        onClick={(e) => {
          e.preventDefault();
          e.stopPropagation();
          setLang("EN");
