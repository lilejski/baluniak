  --secondary-foreground: oklch(0.985 0 0);
  --muted: oklch(0.274 0.006 286.033);
  --muted-foreground: oklch(0.705 0.015 286.067);
  --accent: oklch(0.274 0.006 286.033);
  --accent-foreground: oklch(0.985 0 0);
  --destructive: oklch(0.704 0.191 22.216);
  --border: oklch(1 0 0 / 10%);
  --input: oklch(1 0 0 / 15%);
  --ring: oklch(0.552 0.016 285.938);
  --chart-1: oklch(0.488 0.243 264.376);
  --chart-2: oklch(0.696 0.17 162.48);
  --chart-3: oklch(0.769 0.188 70.08);
  --chart-4: oklch(0.627 0.265 303.9);
  --chart-5: oklch(0.645 0.246 16.439);
  --sidebar: oklch(0.21 0.006 285.885);
  --sidebar-foreground: oklch(0.985 0 0);
  --sidebar-primary: oklch(0.488 0.243 264.376);
  --sidebar-primary-foreground: oklch(0.985 0 0);
  --sidebar-accent: oklch(0.274 0.006 286.033);
  --sidebar-accent-foreground: oklch(0.985 0 0);
  --sidebar-border: oklch(1 0 0 / 10%);
  --sidebar-ring: oklch(0.552 0.016 285.938);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply min-h-screen bg-background text-foreground;
  }
  /* Subtle gradient overlay for depth when dark (does not override page content) */
  .dark body {
    background: radial-gradient(
        ellipse 120% 80% at 50% 0%,
        oklch(0.18 0.008 285.823) 0%,
        transparent 50%
      ),
      var(--background);
  }
}

/* Infinite tech marquee */
@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
@keyframes marquee-reverse {
  0% { transform: translateX(-50%); }
  100% { transform: translateX(0); }
}

/* Glitch text effect */
@keyframes glitch-left {
  0%, 100% { transform: translate(0); }
  25% { transform: translate(-3px, 2px); }
  50% { transform: translate(3px, -2px); }
  75% { transform: translate(-2px, -1px); }
}
@keyframes glitch-right {
  0%, 100% { transform: translate(0); }
  25% { transform: translate(3px, -2px); }
  50% { transform: translate(-3px, 2px); }
  75% { transform: translate(2px, 1px); }
}
.animate-glitch-left {
  animation: glitch-left 3s ease-in-out infinite;
}
.animate-glitch-right {
  animation: glitch-right 3s ease-in-out infinite;
}

/* Cyberpunk grid beams: subtle scanning washes over the background grid */
@keyframes cyber-grid-beam-x {
  0% {
    transform: translateX(-40%);
    opacity: 0;
  }
  15% {
    opacity: 0.65;
  }
  50% {
    transform: translateX(40%);
    opacity: 0.9;
  }
  85% {
    opacity: 0.65;
  }
  100% {
    transform: translateX(120%);
    opacity: 0;
  }
}

@keyframes cyber-grid-beam-y {
  0% {
    transform: translateY(-40%);
    opacity: 0;
  }
  20% {
    opacity: 0.6;
  }
  55% {
    transform: translateY(40%);
    opacity: 0.9;
  }
  90% {
    opacity: 0.6;
  }
  100% {
    transform: translateY(120%);
    opacity: 0;
  }
}
